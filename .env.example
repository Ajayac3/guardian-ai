# Guardian AI — environment placeholders. Copy to .env (gitignored) and fill in.
# Nothing here is required to build; only to connect real services.

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=__local_anon_key__
SUPABASE_SERVICE_ROLE_KEY=__local_service_role_key__

# LiveKit (local dev defaults shown)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Cloudflare R2 (evidence storage)
R2_ACCOUNT_ID=__pending__
R2_ACCESS_KEY_ID=__pending__
R2_SECRET_ACCESS_KEY=__pending__
R2_BUCKET=guardian-evidence

# Firebase Cloud Messaging
FCM_PROJECT_ID=__pending__

# Maps (OpenStreetMap — no key needed; tile URL is configurable)
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Viewer base URL (where the contact link points)
VIEWER_BASE_URL=http://127.0.0.1:5173
